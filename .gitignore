# User data & runtime
data/
cache/
logs/
# Copies of the user's database (listings, favourites, notes): never in the repository
backups/

# Browser binaries (718 MB Chromium — downloaded separately)
browser/

# PyInstaller build output
app/dist/
app/build/
build/

# Stray logs
app/stderr.log

# Release signing key and its passwords: never in the repository
android/signing/
*.jks
*.keystore
keystore.properties

# Android build state and machine-specific SDK path
android/.gradle/
android/build/
android/app/build/
android/local.properties

# The phone app build the desktop server offers for updating (copied there by the Android build)
app/listingtracker/mobile/android/

# Installer output
installer/*.exe
installer/*.zip

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
